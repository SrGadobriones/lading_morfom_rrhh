---
import "../styles/global.css";
import { type Lang, content, localizedPath, asset } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const altLang: Lang = lang === "es" ? "en" : "es";
const altHref = new URL(localizedPath("/", altLang), Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {/* El deploy de prueba en GitHub Pages no debe indexarse. */}
    {import.meta.env.BASE_URL !== "/" && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={altLang} href={altHref} />
    <link rel="alternate" hreflang={lang} href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Morfom" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "es" ? "es_CL" : "en_US"} />
    <meta property="og:image" content={new URL(asset("og.svg"), Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f7f4ec" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <slot />

    <script>
      const reveals = Array.from(document.querySelectorAll(".reveal"));
      const show = (el) => el.classList.add("is-visible");
      const inView = (el) => {
        const r = el.getBoundingClientRect();
        return r.top < window.innerHeight * 0.92 && r.bottom > 0;
      };

      // 1. Anything already on screen at load reveals right away.
      reveals.forEach((el) => {
        if (inView(el)) show(el);
      });

      // 2. The rest reveal on scroll via IntersectionObserver.
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                show(e.target);
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.1 },
        );
        reveals.forEach((el) => {
          if (!el.classList.contains("is-visible")) io.observe(el);
        });
      } else {
        reveals.forEach(show);
      }

      // 3. Safety net: never leave content hidden.
      setTimeout(() => reveals.forEach(show), 2500);
    </script>
  </body>
</html>
